---
interface Props {
    id?: string
    label: string
    href?: string
}

const { id, label, href } = Astro.props
---

{href ? (
    <a id={id} href={href} class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 transition-colors flex-none">
        <slot name="icon" />
        <span class="text-sm md:text-base">{label}</span>
    </a>
) : (
    <button id={id} class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 transition-colors flex-none">
        <slot name="icon" />
        <span class="text-sm md:text-base">{label}</span>
    </button>
)}