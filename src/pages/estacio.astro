---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/Button.astro'
import ModalTrainTimeline from '@/components/ModalTrainTimeline.astro'
---

<Layout title="tingues fe - estacions" description="Cerca una estació i consulta els trens R1, RG1 i R11 que hi passaran.">
	<div class="flex-1 flex flex-col min-h-0">
		<div class="mb-4 flex items-start justify-between gap-2">
			<div class="min-w-0">
				<h1 class="font-bold text-2xl md:text-4xl">tingues fe</h1>
				<h2 class="text-sm md:text-xl text-gray-400">Estacions · Act. en <span id="refreshTime">30</span>s</h2>
			</div>
			<div class="flex gap-2">
				<Button id="link-to-map" href="/" label="Mapa"><img slot="icon" src="/icons/map.svg" class="w-4 h-4 md:w-5 md:h-5 invert" alt="" /></Button>
				<Button id="link-to-list" href="/list" label="Llista"><img slot="icon" src="/icons/list.svg" class="w-4 h-4 md:w-5 md:h-5 invert" alt="" /></Button>
			</div>
		</div>

		<div class="station-search-area relative mb-4">
			<label for="station-search" class="mb-1 block text-sm font-semibold text-gray-300">Cerca una estació</label>
			<input id="station-search" type="search" autocomplete="off" placeholder="Per exemple, Mataró o Girona" class="w-full rounded-xl border border-gray-700 bg-gray-900 px-4 py-3 text-base outline-none transition-colors placeholder:text-gray-500 focus:border-blue-500" />
			<div id="station-results" class="absolute z-20 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-xl border border-gray-700 bg-gray-900 p-1 shadow-2xl"></div>
		</div>

		<p id="stations-message" class="text-gray-400">Cerca i selecciona una estació per veure els propers trens.</p>
		<p id="txtErrorMessage" class="hidden text-red-400">Alguna cosa ha anat malament. Torna-ho a intentar més tard.</p>
		<div id="station-trains" class="mt-3 flex-1 min-h-0 overflow-auto"></div>
		<ModalTrainTimeline />

		<div id="loading" class="hidden absolute top-0 left-0 z-10 w-full h-full"><div class="relative w-full h-full flex items-center justify-center"><div class="relative border-b-3 border-r1 w-1/2 z-20 md:w-1/4 md:border-b-5 rounded-xl"><img src="/icons/train.svg" alt="" class="w-10 animate-trainloading absolute left-0 bottom-0" /></div><div class="absolute top-0 left-0 bg-black opacity-70 w-full h-full rounded-xl"></div></div></div>
	</div>
</Layout>

<script is:inline src="/js/stations.js"></script>
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const mapLink = document.getElementById('link-to-map')
		const listLink = document.getElementById('link-to-list')
		if (mapLink) {
			mapLink.addEventListener('click', () => {
				localStorage.setItem('preferredView', 'map')
			})
		}
		if (listLink) {
			listLink.addEventListener('click', () => {
				localStorage.setItem('preferredView', 'list')
			})
		}
	})
</script>
