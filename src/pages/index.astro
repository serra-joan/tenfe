---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
---

<Layout title="tingues fe - mapa" description="Vista per veure els trens de les linies R1, RG1 i R11 en temps real en format mapa.">
	<script is:inline>
		(() => {
			const params = new URLSearchParams(window.location.search)
			const trainId = params.get('trainId')
			const preferredView = localStorage.getItem('preferredView')
			if (preferredView === 'list' || preferredView === 'estacio') {
				const url = preferredView === 'estacio' ? '/estacio' : (trainId ? `/list?trainId=${trainId}` : '/list')
				window.location.replace(url)
			}
		})()
	</script>

	<div class="mb-2 flex items-center justify-between gap-2">
		<div class="min-w-0">
			<h1 class="font-bold text-2xl md:text-4xl">tingues fe</h1>
			<h2 class="text-sm md:text-xl text-gray-400">Act. en <span id="refreshTime">30</span>s</h2>
		</div>
		<div class="flex gap-2">
			<Button id="link-to-estacio" href="/estacio" label="Estacions"><img slot="icon" src="/icons/train-white.svg" class="w-4 h-4 md:w-5 md:h-5" alt="" /></Button>
			<Button id="link-to-list" href="/list" label="Llista"><img slot="icon" src="/icons/list.svg" class="w-4 h-4 md:w-5 md:h-5 invert" alt="" /></Button>
		</div>
	</div>

	<p id="txtErrorMessage" class="hidden text-red-400">Alguna cosa ha anat malament. Torna-ho a intentar més tard.</p>

    <div class="relative w-full flex-1 min-h-0">
        <div id="map" class="map-container h-full rounded-xl z-0"></div>
        <!-- Line filter buttons -->
        <div id="line-filters" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-1000 flex flex-wrap justify-center gap-2 w-[90%]">
            <button id="filter-R1" onclick="toggleLine('R1')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
                <img src="/images/lines/r1.webp" class="w-5 h-5 rounded" alt="" />
                R1
            </button>
            <button id="filter-R11" onclick="toggleLine('R11')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
                <img src="/images/lines/r11.webp" class="w-5 h-5 rounded" alt="" />
                R11
            </button>
            <button id="filter-RG1" onclick="toggleLine('RG1')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
                <img src="/images/lines/rg1.webp" class="w-5 h-5 rounded" alt="" />
                RG1
            </button>
        </div>
        <div id="loading" class="absolute block top-0 left-0 z-10 w-full h-full">
            <div class="relative w-full h-full flex items-center justify-center">
                <div class="relative border-b-3 border-r1 w-1/2 z-20 md:w-1/4 md:border-b-5 rounded-xl">
                    <img src="/icons/train.svg" alt="Train icon" class="w-10 animate-trainloading absolute left-0 bottom-0" />
                </div>

                <div class="absolute top-0 left-0 bg-black opacity-70 w-full h-full rounded-xl"></div>
            </div>
        </div>
    </div>

    <script src="/js/main.js" defer></script>
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const params = new URLSearchParams(window.location.search)
			const trainId = params.get('trainId')
			const listLink = document.getElementById('link-to-list')
			const estacioLink = document.getElementById('link-to-estacio')
			if (listLink) {
				listLink.addEventListener('click', () => {
					localStorage.setItem('preferredView', 'list')
				})
				if (trainId) listLink.href = `/list?trainId=${trainId}`
			}
			if (estacioLink) {
				estacioLink.addEventListener('click', () => {
					localStorage.setItem('preferredView', 'estacio')
				})
			}
		})
	</script>
</Layout>
