---
import Layout from '@/layouts/Layout.astro';
---

<Layout>
	<div class="flex-1 flex flex-col min-h-0">
		<div class="mb-2 flex items-center justify-between gap-2">
			<div class="min-w-0">
				<h1 class="font-bold text-xl md:text-4xl truncate">Tenfe</h1>
				<h2 class="text-sm md:text-xl text-gray-400">Act. en <span id="refreshTime">30</span>s</h2>
			</div>
			<a id="link-to-map" href="/" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 transition-colors flex-none">
				<img src="/icons/map.svg" class="w-4 h-4 md:w-5 md:h-5 invert" alt="" />
				<span class="text-sm md:text-base">Mapa</span>
			</a>
		</div>

		<p id="txtErrorMessage" class="hidden text-red-400">Alguna cosa ha anat malament. Torna-ho a intentar més tard.</p>

		<div class="flex flex-wrap justify-center gap-1.5 md:gap-2 mb-3 md:mb-4">
			<button id="filter-R1" onclick="toggleLine('R1')" class="flex items-center gap-1 md:gap-1.5 px-2 md:px-3 py-1 md:py-1.5 rounded-lg text-xs md:text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
				<img src="/images/lines/r1.webp" class="w-4 h-4 md:w-5 md:h-5 rounded" alt="" />
				R1
			</button>
			<button id="filter-R11" onclick="toggleLine('R11')" class="flex items-center gap-1 md:gap-1.5 px-2 md:px-3 py-1 md:py-1.5 rounded-lg text-xs md:text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
				<img src="/images/lines/r11.webp" class="w-4 h-4 md:w-5 md:h-5 rounded" alt="" />
				R11
			</button>
			<button id="filter-RG1" onclick="toggleLine('RG1')" class="flex items-center gap-1 md:gap-1.5 px-2 md:px-3 py-1 md:py-1.5 rounded-lg text-xs md:text-sm font-bold border-2 border-white bg-gray-900/90 backdrop-blur-sm text-white shadow-lg transition-all cursor-pointer">
				<img src="/images/lines/rg1.webp" class="w-4 h-4 md:w-5 md:h-5 rounded" alt="" />
				RG1
			</button>
		</div>

		<div id="loading" class="hidden">
			<div class="flex items-center justify-center py-8">
				<div class="border-b-3 border-r1 w-1/2 md:w-1/4 rounded-xl relative">
					<img src="/icons/train.svg" alt="Train icon" class="w-10 animate-trainloading absolute left-0 bottom-0" />
				</div>
			</div>
		</div>

		<div id="train-list" class="flex-1 min-h-0 overflow-auto">
			<table class="w-full text-xs md:text-sm">
				<thead class="sticky top-0 bg-gray-950">
					<tr class="border-b border-gray-700 text-gray-400">
						<th class="text-left py-1.5 md:py-2 px-1.5 md:px-2">Línia</th>
						<th class="text-left py-1.5 md:py-2 px-1.5 md:px-2">Destí</th>
						<th class="text-left py-1.5 md:py-2 px-1.5 md:px-2">Últ. parada</th>
						<th class="text-left py-1.5 md:py-2 px-1.5 md:px-2">Seg. parada</th>
						<th class="text-center py-1.5 md:py-2 px-1.5 md:px-2">Retard</th>
						<th class="text-left py-1.5 md:py-2 px-1.5 md:px-2">Estat</th>
					</tr>
				</thead>
				<tbody id="train-list-body">
				</tbody>
			</table>
		</div>

		<div id="incidents-container" class="mt-4 hidden max-h-40 overflow-auto">
			<h3 class="font-semibold text-lg mb-2">Incidències actives</h3>
			<div id="incidents-list" class="space-y-2"></div>
		</div>
	</div>
</Layout>

<script is:inline src="/js/list.js"></script>
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const params = new URLSearchParams(window.location.search)
		const trainId = params.get('trainId')
		if (trainId) {
			const link = document.getElementById('link-to-map')
			if (link) link.href = `/?trainId=${trainId}`
		}
	})
</script>
