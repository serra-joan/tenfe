---
import '@/styles/global.css'
import { version } from '../../package.json'
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tenfe - map</title>

	<!-- PWA -->
	<link rel="manifest" href="/manifest.json" />
	<meta name="theme-color" content="#1d4ed8" />
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
	<meta name="apple-mobile-web-app-title" content="Tenfe" />

	<!-- Logos -->
	<link rel="apple-touch-icon" href="images/logos/tenfe_small.png">
	<link rel="icon" type="image/png" href="images/logos/tenfe_small.png" />
	<link rel="icon" type="image/png" sizes="192x192" href="images/logos/tenfe_192.png">

	<!-- Share metas -->
	<meta property="og:title" content="tenfe - map" />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Tenfe" />
	<meta property="og:description" content="Mapa en temps real, relativament, d'R1." />
	<meta property="og:url" content="https://tenfe.vercel.app" />
	<meta property="og:image" content="https://tenfe.vercel.app/images/logos/tenfe_192.png" />

	<!-- Leaflet CSS and JS -->
	<link rel="stylesheet" href="/css/leaflet/leaflet.css" crossorigin="" />
	<link rel="stylesheet" href="/css/leaflet/markercluster.css" />
	<script is:inline src="/js/leaflet/leaflet.js" crossorigin=""></script>
	<script is:inline src="/js/leaflet/markercluster.js"></script>

  </head>

  <body class="flex justify-center bg-gray-950 text-gray-100">
    <main class=" flex flex-col w-full h-screen p-2 lg:p-10">
      <slot />

	  <!-- Version -->
	  <div class="text-xs text-gray-400 mt-2 text-center">
		Tenfe - v{version}
	  </div>
    </main>

	<script is:inline src="/js/common.js"></script>
	<script src="/js/main.js" defer></script>

	<script is:inline>
		if ('serviceWorker' in navigator) {
			navigator.serviceWorker.register('/sw.js')
		}
	</script>
  </body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		color-scheme: dark;
	}
</style>
